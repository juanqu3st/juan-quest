APP_NAME=JuanQuest
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-render-service.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ------------------------------------------------------------------
# Database: XAMPP Local (127.0.0.1:3307) OR TiDB Cloud (Port 4000 + TLS)
# For TiDB Cloud Serverless on Render Docker:
#   DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
#   DB_PORT=4000
#   DB_DATABASE=juanquest
#   DB_USERNAME=your_tidb_user
#   DB_PASSWORD=your_tidb_password
#   MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=juanquest
DB_USERNAME=root
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=

# Stateless API (Sanctum Bearer Tokens) + File Cache (zero DB lock contention)
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ------------------------------------------------------------------
# Frontend CORS (Cloudflare Pages URL + optional extra comma-separated URLs)
# ------------------------------------------------------------------
FRONTEND_URL=https://your-juanquest.pages.dev
CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------------
# Cloudinary Media Storage (Videos, Images, Audio + Auto-Delete on CMS delete/replace)
# Set MEDIA_STORAGE_DRIVER=cloudinary and provide Cloud Name + API Key + API Secret
# ------------------------------------------------------------------
MEDIA_STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Set true on first Render deploy if you want migrations to run automatically on boot
AUTO_MIGRATE=false
